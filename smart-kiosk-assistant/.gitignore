__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/

# Generated TTS audio output — runtime artefacts
generated_audio/

# Recorded conversation transcripts (offline analysis; opt-in via
# KIOSK_CORE_CONVERSATION_LOGGING_ENABLED) — runtime artefacts, not source.
conversations/

# Hugging Face model cache
.cache/

# Uploaded/temp audio chunks
chunks/

# Session storage
storage/
.ui-dev/

# Large sample videos — kept locally, not pushed (copy/manage separately)
Sample_data/sample_1.mp4
Sample_data/sample_2.mp4

# Metrics tool output dumps (large, machine-generated)
metrics/

# Benchmark run output (results/JSON/CSV per run) — regenerated by
# `make benchmark` / tests/benchmarks/*.py, not source. Keep the scripts,
# not their output.
results/
tests/benchmarks/results/

# TypeScript incremental build cache (machine/environment-specific)
kiosk-ui/**/*.tsbuildinfo

# pytest functional-test report (regenerated on every run by
# tests/functional/conftest.py's pytest_sessionfinish hook) — output, not source.
tests/functional/test_results.csv
kiosk_core/models/*.onnx
