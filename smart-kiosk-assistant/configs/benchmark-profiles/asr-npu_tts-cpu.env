# Benchmark profile: ASR=NPU, TTS=CPU, LLM=GPU
# Generated member of the ASR x TTS device matrix. See README.md for the
# methodology (why whisper-small and SpeechT5 are pinned across the matrix).
PROFILE_NAME=asr-npu_tts-cpu

# ── ASR (audio-analyzer) ──────────────────────────────────────────────────
# whisper-small is pinned across the whole matrix so DEVICE is the only
# variable. distil-small.en (the production default) is deliberately NOT
# used here: it corrupts on NPU, so it cannot appear in all three legs.
ASR_DEVICE=NPU
ASR_PREVIEW_DEVICE=NPU
ASR_MODEL=whisper-base

# ── TTS (text-to-speech) ──────────────────────────────────────────────────
# SpeechT5 on the OpenVINO runtime is pinned across the whole matrix because
# it is the only engine that runs on all of CPU/GPU/NPU. Kokoro (production
# default) is CPU-only and therefore cannot be device-compared.
TTS_MODEL=microsoft/speecht5_tts
TTS_RUNTIME=openvino
TTS_DEVICE=CPU
TTS_DTYPE=int8
TTS_SPEAKER=Ryan
TTS_MODEL_VARIANT=default

# ── Pinned across every profile (not under test) ──────────────────────────
TARGET_DEVICE=GPU
RAG_EMBEDDING_DEVICE=GPU
RAG_RERANKER_DEVICE=GPU

# Noise reduction: queue-service (YOLO) burns ~650-750%% CPU continuously and
# contends with TTS, the voice pipeline's only CPU-bound stage.
QUEUE=false
KIOSK_CORE_DIARIZATION_ENABLED=false
DIARIZATION_DEVICE=CPU
