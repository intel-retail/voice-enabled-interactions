# Benchmark profile: production defaults (Kokoro CPU TTS + distil-small.en GPU ASR)
#
# This is NOT part of the ASR x TTS device matrix — it is the shipped
# production configuration, included so every matrix number has a real-world
# reference point to be judged against.
#
# It intentionally uses DIFFERENT models from the matrix profiles (see
# README.md "Why the matrix pins non-default models"), so compare it to the
# matrix on absolute latency only — never treat it as the "ASR=GPU, TTS=CPU"
# cell of the matrix.
PROFILE_NAME=baseline-production

# ── ASR (audio-analyzer) ──────────────────────────────────────────────────
# distil-small.en on GPU: ~40-60ms/call once warm. Must stay on GPU — this
# checkpoint corrupts on NPU (stale/frozen output, confirmed twice).
ASR_DEVICE=GPU
ASR_PREVIEW_DEVICE=GPU
ASR_MODEL=distil-whisper/distil-small.en

# ── TTS (text-to-speech) ──────────────────────────────────────────────────
# Kokoro-82M on CPU: ~0.92-0.95s per synthesis, roughly 1/3 of SpeechT5's
# first-phrase cost on CPU. CPU-only (kokoro-onnx CPU execution provider).
TTS_MODEL=kokoro
TTS_RUNTIME=kokoro
TTS_DEVICE=CPU
TTS_DTYPE=int8
TTS_SPEAKER=am_michael
TTS_MODEL_VARIANT=custom_voice

# ── Pinned across every profile (not under test) ──────────────────────────
TARGET_DEVICE=GPU
RAG_EMBEDDING_DEVICE=GPU
RAG_RERANKER_DEVICE=GPU

QUEUE=false
KIOSK_CORE_DIARIZATION_ENABLED=false
DIARIZATION_DEVICE=CPU
