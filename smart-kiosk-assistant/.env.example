# =============================================================================
# Smart Kiosk Assistant — Environment Configuration
# =============================================================================
#
# QUICKSTART:
#   make init-env        # copies this file → .env
#   # edit .env and set HF_TOKEN (the only REQUIRED field)
#   make setup-models    # download the OVMS LLM model (~4 GB)
#   make build           # build Docker images
#   make up              # start the stack  (runs check-env automatically)
#
# LEGEND:
#   [REQUIRED]  — must be set; make up will fail without it
#   [Optional]  — has a safe default; change only if needed
#
# =============================================================================


# =============================================================================
# [REQUIRED] HuggingFace Access Token
# =============================================================================
# Used by:
#   • audio-analyzer — Pyannote speaker diarization (gated model)
#   • setup_models.sh — model download from HuggingFace Hub
#
# Get your token (read-only is fine):
#   https://huggingface.co/settings/tokens
#
# You must also accept the Pyannote model licence at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# =============================================================================
HF_TOKEN=


# =============================================================================
# [REQUIRED] Inference Device
# =============================================================================
# Target hardware for OVMS LLM and OpenVINO models.
# Allowed values: CPU | GPU | NPU
#
# GPU (Intel iGPU) is strongly recommended for real-time latency.
# Prerequisites for GPU:
#   sudo apt-get install -y intel-opencl-icd level-zero
#   sudo usermod -aG render $USER   # log out and back in
# =============================================================================
TARGET_DEVICE=GPU


# =============================================================================
# [REQUIRED for GPU] Render Group ID
# =============================================================================
# Gives Docker containers access to /dev/dri/renderD* (Intel GPU node).
# Run this command to find the correct value on your machine:
#   getent group render | cut -d: -f3
#
# setup_models.sh sets this automatically if you run it first.
# =============================================================================
RENDER_GID=992


# =============================================================================
# [Optional] OVMS LLM Model
# =============================================================================
# Pre-converted OpenVINO IR model downloaded from HuggingFace Hub by
# setup_models.sh into ./models/
#
# Options:
#   OpenVINO/Qwen3-4B-int8-ov   INT8 ~4 GB — better accuracy  (default)
#   OpenVINO/Qwen3-4B-int4-ov   INT4 ~2 GB — smaller, faster
# =============================================================================
OVMS_MODEL_NAME=OpenVINO/Qwen3-4B-int8-ov


# =============================================================================
# [Optional] Docker Image Registry / Release Tag
# =============================================================================
# REGISTRY=intel  → images tagged as intel/<svc>:<RELEASE_TAG>
# Override via: make build REGISTRY=false   (build locally from source)
#               make build REGISTRY=true    (pull from registry)
# =============================================================================
REGISTRY=intel
RELEASE_TAG=2026.2.0-rc2


# =============================================================================
# [Optional] Feature Flags
# =============================================================================
# KIOSK_CORE_IDENTITY_ENABLED — enable face+voice identity service (default: false)
# KIOSK_CORE_QUEUE_SERVICE_ENABLED — enable queue analytics service (default: true)
# KIOSK_CORE_DIARIZATION_ENABLED — enable speaker diarization (default: true).
#   Also gates audio-analyzer's pyannote/segmentation model preload at startup —
#   set to false if HF_TOKEN is unset or the Pyannote model licence has not been
#   accepted (see HF_TOKEN section above).
# =============================================================================
KIOSK_CORE_IDENTITY_ENABLED=false
KIOSK_CORE_QUEUE_SERVICE_ENABLED=true
KIOSK_CORE_DIARIZATION_ENABLED=true


# =============================================================================
# [Optional] Identity Service
# =============================================================================
# IDENTITY_DEVICE — OpenVINO device for identity-service inference (CPU|GPU|NPU)
# BOOTSTRAP_ON_START — auto-enroll faces from ./data/faces on startup
# =============================================================================
IDENTITY_DEVICE=GPU
BOOTSTRAP_ON_START=true


# =============================================================================
# [Optional] RTSP Stream Source
# =============================================================================
# RTSP_SOURCE_MODE — choose which source the rtsp-streamer publishes:
#   sample -> bundled sample clips from SAMPLE_DATA_DIR are streamed
#   live   -> the configured CAMERA_DEVICE is streamed via V4L2
#
# CAMERA_DEVICE — V4L2 device node used only by live mode.
#   Required when RTSP_SOURCE_MODE=live.
#
# Internal variables (computed by Makefile, do not edit):
#   RTSP_CAMERA_DEVICE — resolved by Makefile to /dev/null in sample mode,
#     or to CAMERA_DEVICE value in live mode. Automatically passed to docker
#     compose. Users should not set this directly.
# =============================================================================
RTSP_SOURCE_MODE=sample
CAMERA_DEVICE=

# =============================================================================
# [Optional] V4L2 Camera Capture Settings
# =============================================================================
# CAMERA_INPUT_FORMAT — input format negotiation for the V4L2 device.
#   Common values: mjpeg (default), yuyv422, h264
#   Set to match your camera's native format for best performance.
#
# CAMERA_VIDEO_SIZE — requested video resolution (default: 1920x1080).
#   Must be supported by the camera. Format: WIDTHxHEIGHT
#
# CAMERA_FRAMERATE — input frame rate in fps (default: 30).
#   The GOP size (keyframe interval) defaults to this value for efficient
#   streaming, but can be overridden via CAMERA_GOP.
#
# CAMERA_GOP — H.264 keyframe interval (default: matches CAMERA_FRAMERATE).
#   Higher values reduce bandwidth but increase latency (keyframe-only join).
#   Typically set to framerate or 2× framerate.
# =============================================================================
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_VIDEO_SIZE=1920x1080
CAMERA_FRAMERATE=30
# CAMERA_GOP=60  # Uncomment to override (defaults to CAMERA_FRAMERATE)


# =============================================================================
# [Optional] Sample Videos (queue-service RTSP feed)
# =============================================================================
# Downloaded by:  make download-sample-video
#
# SAMPLE_DATA_DIR — destination directory for the downloaded clips. This is the
#   same directory mounted into the rtsp-streamer container (./Sample_data).
#   Files are always saved as sample_1.mp4 / sample_2.mp4 so they match the
#   MEDIA_FILES entry in docker-compose.yml.
#
# SAMPLE_VIDEO_1_URL / SAMPLE_VIDEO_2_URL — direct download URLs for the two
#   clips. The Pexels page links below are provided as a reference; replace them
#   with the corresponding direct .mp4 download URLs (Pexels "Free Download"
#   link) before running 'make download-sample-video'.
#     https://www.pexels.com/video/performance-promoting-equality-concept-10617615/
#     https://www.pexels.com/video/young-people-standing-in-line-to-promote-equality-10617738/
# =============================================================================
SAMPLE_DATA_DIR=./Sample_data
SAMPLE_VIDEO_1_URL=https://videos.pexels.com/video-files/10617615/10617615-uhd_4096_2160_25fps.mp4
SAMPLE_VIDEO_2_URL=https://videos.pexels.com/video-files/10617738/10617738-uhd_4096_2160_25fps.mp4
 
# Comma-separated list of sample videos played sequentially in sample mode.
# Paths are relative to SAMPLE_DATA_DIR.
MEDIA_FILES=sample_1.mp4,sample_2.mp4
# =============================================================================
# ASR (audio-analyzer) inference placement
# =============================================================================
# ASR_PROVIDER selects the Whisper backend: "openai" (transformers) or
# "openvino". ASR_DEVICE is the OpenVINO device and must be UPPERCASE
# (CPU | GPU | NPU). NPU requires the openvino provider and a static-shape
# encoder; keep CPU unless that path has been validated.
ASR_PROVIDER=openai
ASR_DEVICE=CPU

# Host accelerator node bind-mounted into the inference containers. Set to
# /dev/accel (Intel NPU) only when the device exists; /dev/null is an inert
# placeholder that keeps the compose file valid on machines without an NPU.
ACCEL_MOUNT_PATH=/dev/null

# =============================================================================
# OVMS LLM serving (throughput vs. memory)
# =============================================================================
# KV-cache size in GB, max sequences served concurrently, max tokens per
# batch, and prefix caching (reuses the shared system-prompt prefill across
# turns — leave enabled, it is the largest single latency win).
OVMS_KV_CACHE_GB=4
OVMS_MAX_NUM_SEQS=4
OVMS_MAX_BATCHED_TOKENS=4096
OVMS_PREFIX_CACHING=true

# =============================================================================
# RAG retrieval tuning
# =============================================================================
# RAG_RERANK_THRESHOLD: minimum bge-reranker logit for a chunk to be kept.
# Calibrated on the QuickBite knowledge base: 0.0 kept only 4/20 in-domain
# questions, -7.0 keeps 20/20 at the cost of 2/10 out-of-domain passes.
# Reranker logits are corpus-dependent — re-calibrate if the KB changes.
RAG_RERANK_THRESHOLD=-7.0
# Candidates fetched before reranking. 5 answered 6/8 test questions, 10
# answered 8/8 for ~41 ms more; 20 added no further recall.
RAG_FETCH_K=10
# Character budget for retrieved context. MUST exceed one chunk (~1200 chars)
# or truncation can leave the model without a single complete chunk.
RAG_MAX_CONTEXT_CHARS=1800

# =============================================================================
# [Optional] Agent → TTS sentence streaming
# =============================================================================
# Releases complete sentences from rag-service to kiosk-core as they are
# generated, so TTS synthesis overlaps LLM generation instead of waiting for
# the whole turn. Drives BOTH AGENT_STREAM_SENTENCES (rag-service) and
# KIOSK_CORE_AGENT_STREAM_ENABLED (kiosk-core) — the two must agree, and
# either alone falls back to the buffered /api/v1/agent/chat path.
# Set to false to revert with a restart, no rebuild.
# =============================================================================
AGENT_STREAM_SENTENCES=true
