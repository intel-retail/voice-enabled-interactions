# =============================================================================
# Smart Kiosk Assistant — Environment Configuration
# =============================================================================
#
# QUICKSTART:
#   make init-env        # copies this file → .env
#   # edit .env and set HF_TOKEN (the only REQUIRED field)
#   make setup-models    # download the OVMS LLM model (~4 GB)
#   make build           # build Docker images
#   make up              # start the stack  (runs check-env automatically)
#
# LEGEND:
#   [REQUIRED]  — must be set; make up will fail without it
#   [Optional]  — has a safe default; change only if needed
#
# =============================================================================


# =============================================================================
# [REQUIRED] HuggingFace Access Token
# =============================================================================
# Used by:
#   • audio-analyzer — Pyannote speaker diarization (gated model)
#   • setup_models.sh — model download from HuggingFace Hub
#
# Get your token (read-only is fine):
#   https://huggingface.co/settings/tokens
#
# You must also accept the Pyannote model licences — ALL THREE pages are
# gated and must be accepted with the same account that owns the token:
#   https://huggingface.co/pyannote/speaker-diarization-community-1
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
#
# To skip diarization entirely instead, set KIOSK_CORE_DIARIZATION_ENABLED=false.
# =============================================================================
HF_TOKEN=


# =============================================================================
# [REQUIRED] Inference Device
# =============================================================================
# Target hardware for the ovms-llm container (the served LLM only).
# Allowed values: CPU | GPU | NPU
#
# GPU (Intel iGPU) is strongly recommended for real-time latency.
# Prerequisites for GPU:
#   sudo apt-get install -y intel-opencl-icd level-zero
#   sudo usermod -aG render $USER   # log out and back in
# =============================================================================
TARGET_DEVICE=GPU

# QUEUE_DEVICE — OpenVINO device for the queue-service YOLO26 person detector.
# Allowed values: CPU | GPU | NPU. Defaults to CPU (always available).
# NPU offloads the LLM's shared GPU entirely but cannot use VA (zero-copy)
# memory, costing more CPU (see queue-config.yaml `model.device`/`va_memory`
# comments). GPU + VA memory (QUEUE_VA_MEMORY=auto) cuts that CPU cost ~65%
# but measurably adds ~200-350ms LLM ttft when ovms-llm shares the same GPU
# (A/B-tested 2026-09-24) — prefer NPU unless CPU, not GPU, is the
# bottleneck on your hardware.
QUEUE_DEVICE=CPU

# QUEUE_VA_MEMORY — keep queue-service frames in GPU (VA) memory end-to-end
# instead of downloading to system RAM every frame. auto|true|false.
# "auto" enables it whenever a /dev/dri render node exists and QUEUE_DEVICE
# above isn't CPU. If QUEUE_DEVICE is NPU, set this to "false" — NPU gains
# nothing from VA memory (see queue-service/conf/queue-config.yaml).
QUEUE_VA_MEMORY=auto

# QUEUE_INFERENCE_INTERVAL — run YOLO26 inference every Nth frame instead of
# every frame. Only useful when QUEUE_DEVICE=GPU is contending with
# ovms-llm; raise it (e.g. 5) to shed GPU cycles. Leave at 1 for CPU/NPU.
QUEUE_INFERENCE_INTERVAL=1

# rag-service's own embedding/reranker models are configured independently of
# TARGET_DEVICE — they are exported by optimum-intel with dynamic (unbounded)
# sequence-length shapes, which the NPU compiler rejects. Allowed values:
# CPU | GPU (NPU is not supported for these two models).
RAG_EMBEDDING_DEVICE=GPU
RAG_RERANKER_DEVICE=GPU


# =============================================================================
# [REQUIRED for GPU] Render Group ID
# =============================================================================
# Gives Docker containers access to /dev/dri/renderD* (Intel GPU node).
# Run this command to find the correct value on your machine:
#   getent group render | cut -d: -f3
#
# setup_models.sh sets this automatically if you run it first.
# =============================================================================
RENDER_GID=992


# =============================================================================
# [Optional] OVMS LLM Model
# =============================================================================
# Pre-converted OpenVINO IR model downloaded from HuggingFace Hub by
# setup_models.sh into ./models/
#
# Options:
#   OpenVINO/Qwen3-4B-int8-ov   INT8 ~4 GB — better accuracy  (default)
#   OpenVINO/Qwen3-4B-int4-ov   INT4 ~2 GB — smaller, faster
# =============================================================================
OVMS_MODEL_NAME=OpenVINO/Qwen3-4B-int8-ov


# =============================================================================
# [Optional] Docker Image Registry / Release Tag
# =============================================================================
# REGISTRY=intel  → images tagged as intel/<svc>:<RELEASE_TAG>
# Override via: make build REGISTRY=false   (build locally from source)
#               make build REGISTRY=true    (pull from registry)
# =============================================================================
REGISTRY=true
# Must match the Makefile's own `RELEASE_TAG ?= 2026.1.0` default and the
# version in docs/user-guide/release-notes.md. The Makefile does
# `-include .env` BEFORE that `?=`, so whatever is set here wins for both
# `make` and `docker compose` -- shipping `latest` here meant the two
# disagreed whenever no .env was present, and pointed partners at a floating
# tag instead of the release this branch was tested against.
RELEASE_TAG=2026.1.0

# METRICS_COLLECTOR_TAG — independent from RELEASE_TAG above because
# metrics-collector's source now lives in the edge-ai-suites repo
# (health-and-life-sciences-ai-suite/multi_modal_patient_monitoring/services/
# metrics-collector), shared with the multi-modal patient monitoring suite,
# and is versioned/published on its own release cadence as
# intel/hl-ai-metrics-collector.
METRICS_COLLECTOR_TAG=2026.2.0


# =============================================================================
# [Optional] Feature Flags
# =============================================================================
# KIOSK_CORE_IDENTITY_ENABLED — enable face+voice identity service (default: false)
# KIOSK_CORE_QUEUE_SERVICE_ENABLED — enable queue analytics service (default: true)
# KIOSK_CORE_DIARIZATION_ENABLED — enable speaker diarization (default: true).
#   Also gates audio-analyzer's pyannote/segmentation model preload at startup —
#   set to false if HF_TOKEN is unset or the Pyannote model licence has not been
#   accepted (see HF_TOKEN section above).
# =============================================================================
KIOSK_CORE_IDENTITY_ENABLED=false
KIOSK_CORE_QUEUE_SERVICE_ENABLED=true
KIOSK_CORE_DIARIZATION_ENABLED=true

# KIOSK_CORE_ASR_LANGUAGE — language hint sent with every transcription
# request. MUST be empty whenever the ASR checkpoint is English-only, which
# the shipped default (ASR_MODEL=distil-whisper/distil-small.en) is:
# audio-analyzer turns any value here into an <|en|> token and an
# English-only Whisper rejects it with
#   "Cannot specify 'language' for not multilingual model"
# returning HTTP 500 and an empty transcript on every turn.
#
# Set it to "en" only alongside a multilingual ASR_MODEL (e.g. whisper-base,
# whisper-small), where forcing English measurably helps: Whisper otherwise
# mis-detects language on short kiosk utterances and has been observed
# replying in Spanish. Forcing "en" cut word error rate 11.0% -> 7.0%.
#
# kiosk-core also self-heals: if the analyzer rejects the token, it retries
# that chunk without it and omits it from then on, logging a warning.
KIOSK_CORE_ASR_LANGUAGE=


# =============================================================================
# [Optional] Identity Service
# =============================================================================
# IDENTITY_DEVICE — OpenVINO device for identity-service inference (CPU|GPU|NPU)
# BOOTSTRAP_ON_START — auto-enroll faces from ./data/faces on startup
# =============================================================================
IDENTITY_DEVICE=GPU
BOOTSTRAP_ON_START=true


# =============================================================================
# [Optional] RTSP Stream Source
# =============================================================================
# RTSP_SOURCE_MODE — choose which source the rtsp-streamer publishes:
#   sample -> bundled sample clips from SAMPLE_DATA_DIR are streamed
#   live   -> the configured CAMERA_DEVICE is streamed via V4L2
#
# CAMERA_DEVICE — V4L2 device node used only by live mode.
#   Required when RTSP_SOURCE_MODE=live.
#
# Internal variables (computed by Makefile, do not edit):
#   RTSP_CAMERA_DEVICE — resolved by Makefile to /dev/null in sample mode,
#     or to CAMERA_DEVICE value in live mode. Automatically passed to docker
#     compose. Users should not set this directly.
# =============================================================================
RTSP_SOURCE_MODE=sample
CAMERA_DEVICE=

# =============================================================================
# [Optional] V4L2 Camera Capture Settings
# =============================================================================
# CAMERA_INPUT_FORMAT — input format negotiation for the V4L2 device.
#   Common values: mjpeg (default), yuyv422, h264
#   Set to match your camera's native format for best performance.
#
# CAMERA_VIDEO_SIZE — requested video resolution (default: 1920x1080).
#   Must be supported by the camera. Format: WIDTHxHEIGHT
#
# CAMERA_FRAMERATE — input frame rate in fps (default: 30).
#   The GOP size (keyframe interval) defaults to this value for efficient
#   streaming, but can be overridden via CAMERA_GOP.
#
# CAMERA_GOP — H.264 keyframe interval (default: matches CAMERA_FRAMERATE).
#   Higher values reduce bandwidth but increase latency (keyframe-only join).
#   Typically set to framerate or 2× framerate.
# =============================================================================
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_VIDEO_SIZE=1920x1080
CAMERA_FRAMERATE=30
# CAMERA_GOP=60  # Uncomment to override (defaults to CAMERA_FRAMERATE)


# =============================================================================
# [Optional] Sample Videos (queue-service RTSP feed)
# =============================================================================
# Downloaded by:  make download-sample-video
#
# SAMPLE_DATA_DIR — destination directory for the downloaded clips. This is the
#   same directory mounted into the rtsp-streamer container (./Sample_data).
#   Files are always saved as sample_1.mp4 / sample_2.mp4 so they match the
#   MEDIA_FILES entry in docker-compose.yml.
#
# SAMPLE_VIDEO_1_URL / SAMPLE_VIDEO_2_URL — direct download URLs for the two
#   clips. The Pexels page links below are provided as a reference; replace them
#   with the corresponding direct .mp4 download URLs (Pexels "Free Download"
#   link) before running 'make download-sample-video'.
#     https://www.pexels.com/video/performance-promoting-equality-concept-10617615/
#     https://www.pexels.com/video/young-people-standing-in-line-to-promote-equality-10617738/
# =============================================================================
SAMPLE_DATA_DIR=./Sample_data
SAMPLE_VIDEO_1_URL=https://videos.pexels.com/video-files/10617615/10617615-uhd_4096_2160_25fps.mp4
SAMPLE_VIDEO_2_URL=https://videos.pexels.com/video-files/10617738/10617738-uhd_4096_2160_25fps.mp4
 
# Comma-separated list of sample videos played sequentially in sample mode.
# Paths are relative to SAMPLE_DATA_DIR.
MEDIA_FILES=sample_1.mp4,sample_2.mp4
# =============================================================================
# Audio Analyzer ASR provider/device
# =============================================================================
# Single source of truth:
#   configs/audio-analyzer/config.yaml
#
# Configure ASR provider/device in that file under:
#   models.asr.provider
#   models.asr.device
#
# Examples:
#   OpenVINO + NPU:  provider: openvino, device: NPU
#   OpenAI + CPU:    provider: openai,   device: CPU
#   OpenVINO + CPU:  provider: openvino, device: CPU
#
# OpenAI + NPU is currently unsupported by the OpenAI/PyTorch Whisper backend.
# Keep docker-compose NPU passthrough and Level Zero runtime settings enabled
# for OpenVINO+NPU execution.
#
# Optional Intel NPU passthrough for direct docker compose runs:
#   Leave this as /dev/null on CPU/GPU-only hosts.
#   NOTE: there is no Makefile auto-detection despite older comments here —
#   this must be set explicitly to the host's NPU device node.
#   For OpenVINO + NPU, point it at the host NPU device node, commonly
#   /dev/accel/accel0 on Meteor Lake/Panther Lake systems. Check with
#   `ls /dev/accel/accel*` and confirm the intel_vpu kernel module is loaded.
ACCEL_MOUNT_PATH=/dev/null

# =============================================================================
# OVMS LLM serving (throughput vs. memory)
# =============================================================================
# KV-cache size in GB, max sequences served concurrently, max tokens per
# batch, and prefix caching (reuses the shared system-prompt prefill across
# turns — leave enabled, it is the largest single latency win).
OVMS_KV_CACHE_GB=4
OVMS_MAX_NUM_SEQS=4
# Prefill chunk budget. Raising this to 8192 was measured and produced no
# improvement (2,306 ms vs 2,277 ms on an isolated agent turn; 5,869 ms vs
# 5,951 ms LLM median over a 6-turn replay — both inside noise), because
# AGENT_COMPACT_TOOL_DESCRIPTIONS already brings the static prefill back under
# 4096. Left at the upstream default.
OVMS_MAX_BATCHED_TOKENS=4096
OVMS_PREFIX_CACHING=true

# =============================================================================
# RAG retrieval tuning
# =============================================================================
# RAG_RERANK_THRESHOLD: minimum bge-reranker logit for a chunk to be kept.
# Calibrated on the QuickBite knowledge base: 0.0 kept only 4/20 in-domain
# questions, -7.0 keeps 20/20 at the cost of 2/10 out-of-domain passes.
# Reranker logits are corpus-dependent — re-calibrate if the KB changes.
RAG_RERANK_THRESHOLD=-7.0
# Candidates fetched before reranking. 5 answered 6/8 test questions, 10
# answered 8/8 for ~41 ms more; 20 added no further recall.
RAG_FETCH_K=10
# Character budget for retrieved context. MUST exceed one chunk (~1200 chars)
# or truncation can leave the model without a single complete chunk.
RAG_MAX_CONTEXT_CHARS=1800

# =============================================================================
# [Optional] Agent → TTS sentence streaming
# =============================================================================
# Releases complete sentences from rag-service to kiosk-core as they are
# generated, so TTS synthesis overlaps LLM generation instead of waiting for
# the whole turn. Drives BOTH AGENT_STREAM_SENTENCES (rag-service) and
# KIOSK_CORE_AGENT_STREAM_ENABLED (kiosk-core) — the two must agree, and
# either alone falls back to the buffered /api/v1/agent/chat path.
# Set to false to revert with a restart, no rebuild.
# =============================================================================
AGENT_STREAM_SENTENCES=true

# =============================================================================
# Agent generation limit
# =============================================================================
# Maximum number of new tokens the agent LLM may generate per turn.
# Bounds the worst case only — generation stops at EOS, so a normal turn is
# unaffected. Measured longest legitimate outputs: 84 tokens (full category
# listing), 56 tokens (multi-item tool call).
AGENT_MAX_TOKENS=128

# Strip "Returns:"/"Raises:"/"Example:" sections from MCP tool docstrings before
# they are sent to the LLM as tool schemas. Saves ~428 prefill tokens on each of
# the two LLM calls a tool-calling turn makes (1,627 -> 1,199 across 12 tools).
# Set to false to send the full docstrings again.
AGENT_COMPACT_TOOL_DESCRIPTIONS=true

# =============================================================================
# RAG-service domain config (rag-service decoupling)
# =============================================================================
# Path inside the container where kiosk-specific YAML config files are mounted
# (agent_profile.yaml, intent_rules.yaml, reply_templates.yaml).
# Non-kiosk deployments point this at their own domain config directory.
# The service falls back to safe generic defaults when this is not set.
ORDERING_AGENT_ENABLED=true

# Lab-only ADK vs non-ADK A/B benchmark route (/api/v1/agent/chat-no-adk).
# Leave "false" for every normal deployment; it can place real orders and is
# only for tests/benchmarks/*_no_adk.py.
AGENT_BENCHMARK_ENDPOINTS_ENABLED=false

# =============================================================================
# HuggingFace / Transformers offline mode
# =============================================================================
# Set to 1 to prevent pyannote/transformers from making network calls
# at startup when all models are already cached locally. Default is 0
# (online) so a fresh deployment can download models automatically.
# Set to 1 only after all required models have been cached.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# =============================================================================
# OVMS tool-calling configuration
# =============================================================================
# OVMS_TOOL_PARSER: chat template / tool parser that matches the deployed model.
# Must match the model's built-in chat template (e.g. hermes3 for Qwen-based models).
OVMS_TOOL_PARSER=hermes3
# OVMS_TOOL_GUIDED: enable constrained decoding against the tool JSON schema.
# Improves tool-call reliability; set to false if the model does not support it.
# Tested (Qwen3-4B-int4, this deployment): a small isolated sample suggested
# a TTFT win, but a larger controlled A/B at the real agent endpoint showed
# NO improvement (guided ~730-760ms vs baseline ~705-724ms warm) -- grammar-
# constraint overhead offsets any preamble-token savings. Left disabled.
OVMS_TOOL_GUIDED=false

# =============================================================================
# Kiosk core — conversation behaviour
# =============================================================================
# Number of consecutive unrecognised-speaker chunks before the kiosk prompts
# the customer to speak again.
KIOSK_CORE_CONSECUTIVE_REJECTION_THRESHOLD=2
# Set to true to persist full conversation transcripts for debugging/analytics.
KIOSK_CORE_CONVERSATION_LOGGING_ENABLED=false
# VLM metrics logging (kiosk_core.vlm_metrics_logger). On by default -- pure
# side-channel append-only log write, guarded by its own try/except, so it
# can never break a live turn. Writes into ./results alongside the benchmark
# flow's consolidate-metrics/plot-metrics targets.
KIOSK_CORE_VLM_METRICS_ENABLED=true

# ── Pre-synthesized opener ───────────────────────────────────────────────
# On an ordering turn the model emits only a tool call; the spoken reply is
# templated after the tool returns. Measured on this stack, generating that
# tool-call JSON costs ~1.6 s, during which the customer hears nothing.
# A short phrase is synthesized once, cached, and played immediately to fill
# that gap — time-to-first-audio drops from ~2 s to a file copy. The total
# turn duration is unchanged; the wait is hidden, not removed.
#
# KIOSK_CORE_OPENER_TEXT must stay NON-COMMITTAL: it is spoken before any
# tool has run, so it must never name an item, quantity, price or outcome,
# or it can contradict the reply the menu/confirm guards produce.
KIOSK_CORE_OPENER_ENABLED=true
KIOSK_CORE_OPENER_TEXT=One moment.

# ── Adaptive endpoint ──────────────────────────────────────────────────────
# The end-of-turn wait (KIOSK_CORE_SILENCE_TIMEOUT_SECONDS, 1.1s) has to be
# long enough for a customer hesitating mid-sentence, so every turn pays that
# hesitation tax. When the transcript already reads as a finished sentence the
# turn can commit sooner. If no transcript has arrived yet the check fails
# closed and the full timeout applies, so this can only ever shorten a turn.
# SHORT_SECONDS must sit between KIOSK_CORE_ADAPTIVE_FLUSH_PAUSE_SECONDS (0.50)
# and KIOSK_CORE_SILENCE_TIMEOUT_SECONDS (1.1), and above the tail chunk's ASR
# latency, or the transcript lands too late for the check to ever pass.
#
# 0.15 below matches kiosk-voice-lab-main's endpoint_short_ms, but is CURRENTLY
# INERT on this pipeline: the adaptive flush that produces a transcript to
# check completeness against does not fire until 0.50s of silence, so the
# 0.15s check never has a transcript to read yet. It becomes load-bearing once
# continuous/rolling ASR replaces the flush-on-pause design (see
# kiosk_core/config.py's DEFAULT_ENDPOINT_SHORT_SECONDS docstring).
KIOSK_CORE_ENDPOINT_COMPLETE_ENABLED=true
KIOSK_CORE_ENDPOINT_SHORT_SECONDS=0.15
KIOSK_CORE_ENDPOINT_MIN_WORDS=3

# ── Continuous ASR streaming (WebSocket to audio-analyzer) ──────────────────
# When enabled, PCM frames are sent continuously to audio-analyzer's
# /v1/realtime WebSocket instead of POSTed as a WAV file per flush, so ASR
# runs throughout speech instead of only after a pause begins. This is what
# activates the KIOSK_CORE_ENDPOINT_SHORT_SECONDS completeness shortcut above
# — without it, a fresh transcript usually isn't ready until the full
# silence-timeout wait, so the shortcut rarely gets a chance to fire early.
# Falls back to the file-POST path per-session if the socket fails to
# connect. Default off.
KIOSK_CORE_ANALYZER_STREAMING_ENABLED=false

# ── Skip empty final tail-chunk ASR call (experimental) ─────────────────────
# Tier 2 roadmap item #4, adapted to this codebase: at endpoint, the final
# tail chunk usually holds only trailing silence (the adaptive-pause flush
# above already sent every real word). Transcribing that silence still pays
# Whisper's fixed per-call round trip for no benefit. When enabled, that call
# is skipped whenever no unflushed speech landed since the last flush; a
# genuine short trailing utterance still gets its final flush as before.
# Default off pending live A/B measurement.
KIOSK_CORE_SKIP_EMPTY_FINAL_FLUSH_ENABLED=false

# ── Adaptive pause / trailing-silence trim / VAD / speculative execution ────
# See docker-compose.yml for the full rationale comments next to each of
# these; defaults below match the compose file's fallbacks.
# 0.50 is the validated floor from config.py — below it the chunk is cleared
# mid-phrase and the tail is hallucinated or truncated, and an ordinary
# mid-sentence breath is enough to end the turn.
KIOSK_CORE_ADAPTIVE_FLUSH_PAUSE_SECONDS=0.50
KIOSK_CORE_ENDPOINT_STABLE_SECONDS=0
KIOSK_CORE_ASR_TRIM_TRAILING_SILENCE_ENABLED=false
KIOSK_CORE_ASR_TRIM_DECAY_SECONDS=0.15
KIOSK_CORE_SILERO_VAD_ENABLED=true

# ── Speculative decoding / TTS pre-synthesis (experimental, default off) ────
KIOSK_CORE_SPECULATIVE_DRAFT_ENABLED=false
KIOSK_CORE_SPECULATIVE_TTS_PRESYNTH_ENABLED=false

# ── Directive mode (tool-free fast path for order-mutation turns) ──────────
# See docs/reports/ for the LLM TTFT investigation this came out of.
AGENT_DIRECTIVE_MODE=false

# ── ASR inference device override (audio-analyzer) ──────────────────────────
# Default is GPU: the final/persisted-commit ASR pool now runs
# distil-whisper/distil-small.en (see configs/audio-analyzer/config.yaml),
# proven stable on GPU (~400ms round-trip vs ~500-570ms for whisper-small on
# CPU). Do NOT set this to NPU — distil-small.en is known to corrupt its
# internal generation state on NPU with openvino_genai (stale/repeated
# output regardless of new input); CPU remains a safe fallback if no GPU is
# available. Also set ACCEL_MOUNT_PATH (see below) when targeting GPU/NPU
# hardware passthrough, or it silently stays disabled.
ASR_DEVICE=GPU

# ── Device-combination benchmarking ─────────────────────────────────────────
# Everything below exists so a benchmarker can compare inference devices
# (ASR on CPU/GPU/NPU x TTS on CPU/GPU/NPU, LLM pinned to GPU) WITHOUT editing
# any mounted config file. In normal operation leave them all unset: every
# default below reproduces configs/{audio-analyzer,text-to-speech}/config.yaml
# exactly, so an ordinary `make up` is unaffected.
#
# The supported workflow is a PROFILE — an env file under
# configs/benchmark-profiles/ holding one device combination:
#
#   make list-profiles
#   make validate-profile PROFILE=asr-npu_tts-cpu   # pre-flight, no bring-up
#   make benchmark        PROFILE=asr-npu_tts-cpu   # -> results/asr-npu_tts-cpu/
#   make benchmark-matrix                           # every profile + comparison
#
# See configs/benchmark-profiles/README.md for the full engine/device
# compatibility matrix and why the matrix pins non-default models.

# ASR model override (audio-analyzer). Paired with ASR_DEVICE because the two
# are not independent: distil-small.en corrupts on NPU, so any NPU profile must
# also move to an NPU-safe checkpoint: whisper-base (or whisper-tiny). Anything
# whisper-small or larger fails to compile on NPU.
ASR_MODEL=distil-whisper/distil-small.en

# Preview (streaming/partial) ASR pool device. Must be a literal CPU, GPU or
# NPU -- a .env file is NOT a shell, so "${ASR_DEVICE:-CPU}" here is read
# verbatim and rejected by `make validate-profile`, which aborts
# `make benchmark` on the shipped defaults. Set it to the same value as
# ASR_DEVICE unless you deliberately want to split the preview and
# final-commit pools. Leave it commented out to inherit ASR_DEVICE: the
# fallback lives in docker-compose.yml, where shell expansion does work.
# ASR_PREVIEW_DEVICE=CPU

# Diarization device. CPU only — the component loads via torch.device(<value>)
# and PyTorch has no "gpu" string (Intel GPU would need "xpu", not wired here).
DIARIZATION_DEVICE=CPU

# TTS engine selection. These move TOGETHER — the TTS factory picks an
# implementation from (name, runtime) and then hands it `device`, so an
# inconsistent triple fails at model load:
#   Kokoro   : kokoro / kokoro                            -> CPU only
#   SpeechT5 : microsoft/speecht5_tts / openvino          -> CPU | GPU | NPU
#   Qwen     : Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice / openvino -> CPU | GPU
# Voice vocabularies do NOT overlap (Kokoro am_michael vs SpeechT5 Ryan), so
# TTS_SPEAKER must change with the model or every request fails validation.
# The values below are the production defaults; a profile overrides them, e.g.
# SpeechT5 uses TTS_MODEL=microsoft/speecht5_tts TTS_RUNTIME=openvino TTS_SPEAKER=Ryan.
TTS_MODEL=kokoro
TTS_RUNTIME=kokoro
TTS_DEVICE=CPU
TTS_SPEAKER=am_michael
TTS_MODEL_VARIANT=custom_voice

# TTS precision. NOT cosmetic on GPU: int8 on this iGPU measured 281s first
# call / 8.7-8.8s steady-state per synthesis versus 0.92-0.95s on CPU, and
# int4 produces audible noise. Any GPU profile MUST use fp16 —
# `make validate-profile` rejects GPU+int8 outright.
TTS_DTYPE=int8

# Per-profile output directories, set automatically by the Makefile from
# PROFILE. Listed here only because docker-compose.yml reads them for the
# kiosk-core /app/results and metrics-collector /tmp/results bind mounts.
# Unset => ./results and ./metrics, exactly as before profiles existed.
KIOSK_RESULTS_HOST_DIR=./results
KIOSK_METRICS_HOST_DIR=./metrics

# ── TTS worker pool size ─────────────────────────────────────────────────────
TEXT_TO_SPEECH_WORKERS=2

# ── metrics-collector image registry override ───────────────────────────────
# Leave unset/default unless mirroring the image to a private registry.
METRICS_COLLECTOR_REGISTRY=intel

